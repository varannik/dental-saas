{
  "name": "dental-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "licence:check": "pnpm --filter @dental/config build && node scripts/licences/check.mjs",
    "stack:up": "docker compose -f infra/compose/compose.dev.yml up -d --wait",
    "stack:down": "docker compose -f infra/compose/compose.dev.yml down",
    "stack:ps": "docker compose -f infra/compose/compose.dev.yml ps",
    "prepare": "husky",
    "db:migrate": "pnpm --filter @dental/db build && node --env-file=.env packages/db/dist/cli.js",
    "e2e": "pnpm --filter @dental/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
