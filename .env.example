# ============================================================================
# Dental SaaS Platform - Environment Variables
# ============================================================================
# Copy to `.env` at the repo root (and adjust). Never commit real secrets.
#
# Precedence (packages/config): .env.development.local → .env.local → .env.development → .env
# First file wins per variable (with override: false). Check .env.local if values look stale.
#
# Docker Compose loads this file via env_file; in-network DATABASE_URL is overridden
# in docker-compose.yml (postgres:5432). On your Mac, use localhost:5433 to reach that DB.
# ============================================================================

# ----------------------------------------------------------------------------
# Core App
# ----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
PORT=4000
APP_PORT=3000
API_GATEWAY_PORT=4000

# ----------------------------------------------------------------------------
# Web / Test Targets
# ----------------------------------------------------------------------------
BASE_URL=http://localhost:3000
TEST_API_URL=http://localhost:3001
CI=false
DEBUG=0

# ----------------------------------------------------------------------------
# Database (PostgreSQL) — host → Docker Compose Postgres (published port 5433)
# If DATABASE_URL is already set in your shell (e.g. @localhost:5432), it overrides this file (dotenv override: false).
# Use: unset DATABASE_URL  or fix the shell value before starting services.
# ----------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=dental_saas
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dental_saas

# Script helpers (migrate.sh, seed.sh, etc.)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dental_saas
DB_USER=postgres
DB_PASSWORD=postgres

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Optional: Sentinel / tests
SENTINEL_PASSWORD=
REDIS_TEST_HOST=localhost
REDIS_TEST_PORT=6379

# ----------------------------------------------------------------------------
# API Gateway (host)
# ----------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=4000
# Docker API stack (make docker-up-apps): gateway uses http://auth:4001 etc. inside Compose (see docker-compose.yml).
# For host-run tools (migrations, scripts), keep 127.0.0.1 and published ports below.
AUTH_SERVICE_URL=http://127.0.0.1:4001
# Browser page origin(s) for apps/web (not the gateway URL). Docker gateway sets these in compose.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----------------------------------------------------------------------------
# Auth service (host)
# ----------------------------------------------------------------------------
AUTH_HOST=0.0.0.0
AUTH_PORT=4001

# ----------------------------------------------------------------------------
# Next.js (Next only reads apps/web/.env*; copy NEXT_PUBLIC_* there if needed)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:4000

# ----------------------------------------------------------------------------
# Auth / Session / Security
# ----------------------------------------------------------------------------
JWT_SECRET=change-me-development-only-min-32-characters
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=dental-saas
FIELD_ENCRYPTION_KEY=change-me-32+chars-for-field-encryption

# ----------------------------------------------------------------------------
# AI / Voice
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ----------------------------------------------------------------------------
# Storage (MinIO/S3)
# ----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=dental-saas-local
S3_REGION=eu-central-1

# ----------------------------------------------------------------------------
# AWS / LocalStack / Infra
# ----------------------------------------------------------------------------
AWS_PROFILE=default
AWS_REGION=eu-central-1
AWS_DEFAULT_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LOCALSTACK_ENDPOINT=http://localhost:4566

# ----------------------------------------------------------------------------
# Payments / Email
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_USER=
SMTP_PASS=

# ----------------------------------------------------------------------------
# Monitoring / Observability
# ----------------------------------------------------------------------------
SENTRY_DSN=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dental-saas
