# Copy to .env for local development. The API refuses to start if a value is missing.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# The API connects as the application role, which cannot bypass row-level security.
# Start-up refuses a superuser connection. Migrations and seeding use the owner.
DATABASE_URL=postgresql://app:app@localhost:5433/dental
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5433/dental

# Ed25519 key for access tokens. Required in production; without it a key is generated per
# process and sessions end on restart. Generate: pnpm --filter @dental/api auth:keygen
AUTH_PRIVATE_KEY=
# 32 random bytes, base64. Encrypts patient identifiers such as national IDs; required in production.
DATA_ENCRYPTION_KEY=
# 32 random bytes, base64. Encrypts TOTP secrets; required in production. auth:keygen prints one.
MFA_ENCRYPTION_KEY=
AUTH_ACCESS_TTL_SECONDS=600
AUTH_REFRESH_TTL_DAYS=7
VALKEY_URL=redis://localhost:6380
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=dental
S3_ACCESS_KEY=dev
S3_SECRET_KEY=devsecret
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword

# Voice spike (F7). Development only: the endpoint is unauthenticated and refused in production.
VOICE_SPIKE_ENABLED=false
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Interpreters: each provider with a key can be chosen on the spike page.
# VOICE_INTERPRETER is the default and its key is required.
VOICE_INTERPRETER=anthropic
ANTHROPIC_API_KEY=
VOICE_LLM_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Run BiOS gateway, OpenAI-compatible API. Use the inference key (bios-…), not the platform key (sk-bios-…).
# Model ids carry a provider prefix; see https://api.runbios.ai/v1/models.
RUNBIOS_API_KEY=
RUNBIOS_MODEL=openai/gpt-4.1-mini
RUNBIOS_BASE_URL=https://api.runbios.ai/v1
